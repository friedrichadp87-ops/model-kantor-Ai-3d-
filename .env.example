# GEMINI_API_KEY: Kunci API Gemini global (fallback jika kunci khusus channel belum diisi).
# AI Studio otomatis menyuntikkan ini di runtime dari panel Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PERUTEAN 3 KUNCI API GEMINI PER CHANNEL YOUTUBE (Opsional — isolasi kuota per channel)
# Atur masing-masing di panel Settings > Secrets (server-only, tidak pernah dikirim ke browser).
GEMINI_API_KEY_STORIES_3D=""
GEMINI_API_KEY_DAILY_FAITH=""
GEMINI_API_KEY_FACTS_MYSTERIES=""

# APP_URL: URL aplikasi saat di-host (disuntikkan otomatis oleh runtime).
APP_URL="MY_APP_URL"

# OLLAMA_BASE_URL: Endpoint server Ollama lokal (contoh: http://127.0.0.1:11434).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# ELEVENLABS_API_KEY: Kunci API ElevenLabs global untuk narasi suara (TTS).
ELEVENLABS_API_KEY=""
# PERUTEAN 3 KUNCI API ELEVENLABS PER CHANNEL YOUTUBE (Opsional)
ELEVENLABS_API_KEY_STORIES_3D=""
ELEVENLABS_API_KEY_DAILY_FAITH=""
ELEVENLABS_API_KEY_FACTS_MYSTERIES=""

ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
