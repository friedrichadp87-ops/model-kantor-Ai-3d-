# Firebase project used by the web client and verified by the Netlify API.
FIREBASE_PROJECT_ID="kantor-ai-agent-creator"

# Optional comma-separated UID allowlist for a single-owner deployment.
# Set this to the Firebase Authentication UID of the owner in Netlify.
# REQUIRED: production API access is denied until this contains the owner's UID.
# Copy the UID (not email address) from Firebase Console > Authentication > Users.
FIREBASE_ALLOWED_UIDS=""

# Keep provider keys in Netlify Environment Variables, never in source control.
# GEMINI_API_KEY=""
# ELEVENLABS_API_KEY=""
