{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pemilik studio yang kompatibel 100% dengan validProfile di proyek kantor-ai-agent-creator",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Pengaturan non-rahasia Kantor AI 3D (template 3 channel & routing provider AI)",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "channelTemplates": {
          "type": "object"
        },
        "providerConfig": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "ownerUid",
        "channelTemplates",
        "providerConfig",
        "updatedAt"
      ]
    },
    "ShortsQueueItem": {
      "title": "ShortsQueueItem",
      "description": "Item antrean produksi YouTube Shorts 3 channel beserta hasil Guardian",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "channelId": {
          "type": "string",
          "enum": [
            "bible-stories-3d",
            "daily-faith-inspiration",
            "bible-facts-mysteries",
            "gkin-hosiana"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "bibleReference": {
          "type": "string",
          "maxLength": 160
        },
        "durationSeconds": {
          "type": "number",
          "enum": [
            30,
            45,
            60
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 800
        },
        "stage": {
          "type": "string",
          "enum": [
            "Ide",
            "Dalam Produksi",
            "Siap Publikasi",
            "Sudah Terbit (manual)"
          ]
        },
        "guardianStatus": {
          "type": "string",
          "enum": [
            "LULUS",
            "PERLU REVISI",
            "DITOLAK",
            "BELUM DICEK"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "ownerUid",
        "channelId",
        "title",
        "bibleReference",
        "durationSeconds",
        "notes",
        "stage",
        "guardianStatus",
        "updatedAt"
      ]
    },
    "AgentTaskRecord": {
      "title": "AgentTaskRecord",
      "description": "Riwayat tugas yang dieksekusi oleh salah satu dari 13 agen AI Kantor AI 3D",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "agentId": {
          "type": "string",
          "enum": [
            "ceo",
            "trend-researcher",
            "bible-researcher",
            "scriptwriter",
            "theological-guardian",
            "pastoral-checker",
            "storyboard-artist",
            "visual-curator",
            "video-composer",
            "voice-artist",
            "video-editor",
            "seo-publisher",
            "community-prayer"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 2000
        },
        "output": {
          "type": "string",
          "maxLength": 12000
        },
        "error": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "error"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "ownerUid",
        "agentId",
        "prompt",
        "output",
        "error",
        "status",
        "createdAt",
        "completedAt"
      ]
    },
    "MasterBibleMeta": {
      "title": "MasterBibleMeta",
      "description": "Metadata Master Alkitab Terjemahan Baru (TB) milik pemilik studio yang dibagikan ke seluruh Lantai 1, 2 & 3",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "sourceName": {
          "type": "string",
          "maxLength": 200
        },
        "publisher": {
          "type": "string",
          "maxLength": 200
        },
        "year": {
          "type": "string",
          "maxLength": 40
        },
        "copyrightStatement": {
          "type": "string",
          "maxLength": 500
        },
        "indexedVerseCount": {
          "type": "number"
        },
        "bookCount": {
          "type": "number"
        },
        "chapterCount": {
          "type": "number"
        },
        "missingBookCount": {
          "type": "number"
        },
        "chunkCount": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "ownerUid",
        "sourceName",
        "publisher",
        "year",
        "copyrightStatement",
        "indexedVerseCount",
        "bookCount",
        "chapterCount",
        "missingBookCount",
        "chunkCount",
        "updatedAt"
      ]
    },
    "MasterBibleChunk": {
      "title": "MasterBibleChunk",
      "description": "Potongan ayat Master Alkitab Terjemahan Baru (<= 400 KB per dokumen agar aman di bawah batas 1 MB Firestore)",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "chunkIndex": {
          "type": "number"
        },
        "chunkCount": {
          "type": "number"
        },
        "verseCount": {
          "type": "number"
        },
        "verses": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "ownerUid",
        "chunkIndex",
        "chunkCount",
        "verseCount",
        "verses",
        "updatedAt"
      ]
    },
    "WorkHistoryRecord": {
      "title": "WorkHistoryRecord",
      "description": "Append-only audit event for every AI activity across each Kantor AI 3D floor, including project/run, agent, stage, input, result, provider, Master Bible source and errors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 140
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "floorId": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ]
        },
        "floorName": {
          "type": "string",
          "maxLength": 100
        },
        "channelId": {
          "type": "string",
          "enum": [
            "daily-faith-inspiration",
            "bible-stories-3d",
            "bible-facts-mysteries"
          ]
        },
        "channelName": {
          "type": "string",
          "maxLength": 120
        },
        "projectId": {
          "type": "string",
          "maxLength": 140
        },
        "runId": {
          "type": "string",
          "maxLength": 140
        },
        "taskId": {
          "type": "string",
          "maxLength": 140
        },
        "agentId": {
          "type": "string",
          "maxLength": 80
        },
        "agentName": {
          "type": "string",
          "maxLength": 120
        },
        "stageId": {
          "type": "string",
          "maxLength": 100
        },
        "stageTitle": {
          "type": "string",
          "maxLength": 180
        },
        "eventType": {
          "type": "string",
          "maxLength": 100
        },
        "phase": {
          "type": "string",
          "enum": [
            "start",
            "completed",
            "error",
            "warning"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 240
        },
        "input": {
          "type": "string",
          "maxLength": 10000
        },
        "output": {
          "type": "string",
          "maxLength": 18000
        },
        "error": {
          "type": "string",
          "maxLength": 4000
        },
        "detail": {
          "type": "string",
          "maxLength": 4000
        },
        "provider": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 120
        },
        "masterBibleActive": {
          "type": "boolean"
        },
        "masterBibleSourceName": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "ownerUid",
        "floorId",
        "floorName",
        "channelId",
        "channelName",
        "projectId",
        "runId",
        "taskId",
        "agentId",
        "agentName",
        "stageId",
        "stageTitle",
        "eventType",
        "phase",
        "title",
        "input",
        "output",
        "error",
        "detail",
        "provider",
        "model",
        "masterBibleActive",
        "masterBibleSourceName",
        "createdAt",
        "completedAt"
      ]
    },
    "YoutubeConnection": {
      "title": "YoutubeConnection",
      "description": "Server-encrypted YouTube OAuth refresh-token record; browser UI receives sanitized status only.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string"
        },
        "channelId": {
          "type": "string",
          "enum": [
            "daily-faith-inspiration",
            "bible-stories-3d",
            "bible-facts-mysteries"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "connected"
          ]
        },
        "googleEmail": {
          "type": "string"
        },
        "googleDisplayName": {
          "type": "string"
        },
        "encryptedRefreshToken": {
          "type": "string",
          "description": "AES-256-GCM ciphertext only."
        },
        "autoUploadEnabled": {
          "type": "boolean"
        },
        "privacyStatus": {
          "type": "string",
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "targetChannelLabel": {
          "type": "string"
        },
        "connectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUploadAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "channelId",
        "status",
        "encryptedRefreshToken",
        "autoUploadEnabled",
        "privacyStatus",
        "connectedAt",
        "updatedAt"
      ]
    },
    "YoutubeUpload": {
      "title": "YoutubeUpload",
      "description": "Audit record for published videos and SEO metadata.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string"
        },
        "channelId": {
          "type": "string"
        },
        "videoId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "privacyStatus": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "videoUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "ownerUid",
        "channelId",
        "videoId",
        "title",
        "description",
        "privacyStatus",
        "status",
        "createdAt",
        "videoUrl"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Dokumen profil pengguna terautentikasi (selaras 100% dengan validProfile proyek kantor-ai-agent-creator)"
    },
    "/users/{userId}/workspace/settings": {
      "schema": {
        "$ref": "#/entities/WorkspaceSettings"
      },
      "description": "Template 3 channel YouTube Shorts dan konfigurasi routing provider non-rahasia Kantor AI 3D"
    },
    "/users/{userId}/shortsQueue/{itemId}": {
      "schema": {
        "$ref": "#/entities/ShortsQueueItem"
      },
      "description": "Antrean produksi konten Shorts 3 channel milik pengguna di Kantor AI 3D"
    },
    "/users/{userId}/agentTasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/AgentTaskRecord"
      },
      "description": "Riwayat tugas dan keluaran dari 13 agen AI milik pengguna di Kantor AI 3D"
    },
    "/users/{userId}/masterBible/meta": {
      "schema": {
        "$ref": "#/entities/MasterBibleMeta"
      },
      "description": "Metadata Master Alkitab Terjemahan Baru (TB) milik pemilik studio untuk L1, L2 & L3"
    },
    "/users/{userId}/masterBibleChunks/{chunkId}": {
      "schema": {
        "$ref": "#/entities/MasterBibleChunk"
      },
      "description": "Potongan ayat Alkitab Terjemahan Baru yang terpecah aman di bawah batas 1 MB per dokumen Firestore"
    },
    "/users/{userId}/workHistory/{eventId}": {
      "schema": {
        "$ref": "#/entities/WorkHistoryRecord"
      },
      "description": "Append-only audit history of AI work and errors for the user's three floors, ordered by createdAt descending."
    },
    "/users/{userId}/youtubeConnections/{channelId}": {
      "schema": {
        "$ref": "#/entities/YoutubeConnection"
      },
      "description": "Encrypted YouTube OAuth connection per owner and channel."
    },
    "/users/{userId}/youtubeUploads/{videoId}": {
      "schema": {
        "$ref": "#/entities/YoutubeUpload"
      },
      "description": "History of YouTube uploads made by the SEO Publisher agent."
    }
  }
}
