rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and non-audit application data remain private to each owner.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The generic user-data rule deliberately excludes workHistory so its records
    // cannot be updated or deleted after they have been written.
    match /users/{userId}/{collectionName}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionName != 'workHistory';
    }

    // Append-only AI audit trail: owners may read and create their own events,
    // but no client may rewrite or delete an existing history record.
    match /users/{userId}/workHistory/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerUid == userId
        && request.resource.data.id == eventId;
      allow update, delete: if false;
    }

    // No public or cross-user Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
