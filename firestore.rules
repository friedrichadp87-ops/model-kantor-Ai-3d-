rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's profile, Master Bible, queue, production logs and work history
    // are private to the Firebase Authentication UID that owns the path.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // No public or cross-user Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
